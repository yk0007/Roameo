# Roameo Backend Environment
NODE_ENV=development
PORT=4000

# Model providers
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_BALANCED=gemini-2.5-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro

OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_BALANCED=gpt-5.4-mini
OPENAI_MODEL_DEEP=gpt-5.4

# Google Maps Platform
GOOGLE_MAPS_API_KEY=

# Tavily (optional)
TAVILY_API_KEY=

# Supabase (optional now)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ROAMEO_ENCRYPTION_SECRET=

# Frontend base URLs (optional overrides)
APP_BASE_URL=http://localhost:4000
