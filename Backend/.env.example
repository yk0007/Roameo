# Roameo Backend Environment
NODE_ENV=development
PORT=3000

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# Google Maps Platform
GOOGLE_MAPS_API_KEY=

# Tavily (optional)
TAVILY_API_KEY=

# Supabase (optional now)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Memcached Configuration
MEMCACHED_SERVERS=localhost:11211
# For multiple servers: server1:11211,server2:11211
# Admin token for cache management endpoints (optional)
ADMIN_TOKEN=

# Frontend base URLs (optional overrides)
APP_BASE_URL=https://roameo-app.vercel.app
WS_BASE_URL=wss://roameo.onrender.com/ws
