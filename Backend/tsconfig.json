{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/agents",
    "src/cache",
    "src/db",
    "src/graph",
    "src/tools",
    "src/ws",
    "src/api/cache.ts",
    "src/api/maps.ts",
    "src/utils/rateLimiter.ts",
    "src/utils/supabase-pool.ts"
  ]
}
