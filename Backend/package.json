{
  "name": "roameo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm --prefix ../packages/contracts run build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "npm --prefix ../packages/contracts run build && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && sh -c 'files=$(find dist -name \"*.test.js\" -type f); [ -n \"$files\" ] && node --test $files || echo \"No tests found\"'"
  },
  "dependencies": {
    "@google/genai": "^1.47.0",
    "@roameo/contracts": "file:../packages/contracts",
    "@supabase/supabase-js": "^2.101.1",
    "bullmq": "^5.58.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.8.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.33.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^25.5.0",
    "@types/node-fetch": "^2.6.13",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  }
}
